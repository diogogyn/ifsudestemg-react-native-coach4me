ative-coach4me\\web\\src\\index.tsx",[],"C:\\Users\\paula\\OneDrive\\Documentos\\GitHub\\ifsudestemg-react-native-coach4me\\web\\src\\App.tsx",[],"C:\\Users\\paula\\OneDrive\\Documentos\\GitHub\\ifsudestemg-react-native-coach4me\\web\\src\\routes.tsx",[],"C:\\Users\\paula\\OneDrive\\Documentos\\GitHub\\ifsudestemg-react-native-coach4me\\web\\src\\pages\\CoachList\\index.tsx",[],"C:\\Users\\paula\\OneDrive\\Documentos\\GitHub\\ifsudestemg-react-native-coach4me\\web\\src\\pages\\Landing\\index.tsx",[],"C:\\Users\\paula\\OneDrive\\Documentos\\GitHub\\ifsudestemg-react-native-coach4me\\web\\src\\pages\\CoachForm\\index.tsx",[],"C:\\Users\\paula\\OneDrive\\Documentos\\GitHub\\ifsudestemg-react-native-coach4me\\web\\src\\services\\api.ts",[],"C:\\Users\\paula\\OneDrive\\Documentos\\GitHub\\ifsudestemg-react-native-coach4me\\web\\src\\components\\Input\\index.tsx",[],"C:\\Users\\paula\\OneDrive\\Documentos\\GitHub\\ifsudestemg-react-native-coach4me\\web\\src\\components\\CoachItem\\index.tsx",["51"],"import React from 'react';\r\n\r\nimport api from '../../services/api';\r\n\r\nimport whatsappIcon from '../../assets/images/icons/whatsapp.svg';\r\n\r\nimport './styles.css';\r\n\r\nexport interface Coach {\r\n  id: number;\r\n  avatar: string;\r\n  bio: string;\r\n  cost: number;\r\n  name: string;\r\n  subject: string;\r\n  whatsapp: string;\r\n}\r\n\r\ninterface CoachItemProps {\r\n  coach: Coach;\r\n}\r\n\r\nconst CoachItem: React.FC<CoachItemProps> = ({ coach }) => {\r\n  function createNewConnection() {\r\n    api.post('connections', {\r\n      coach_id: coach.id,\r\n    });\r\n  }\r\n\r\n  return (\r\n    <article className=\"coach-item\">\r\n      <header>\r\n        <img src={coach.avatar} alt={coach.name} />\r\n        <div>\r\n          <strong>{coach.name}</strong>\r\n          <span>{coach.subject}</span>\r\n        </div>\r\n      </header>\r\n\r\n      <p>{coach.bio}</p>\r\n\r\n      <footer>\r\n        <p>Preço/Hora\r\n          <strong>R$ {coach.cost}</strong>\r\n        </p>\r\n        \r\n        <a\r\n          target=\"_blank\" \r\n          onClick={createNewConnection} \r\n          href={`https://wa.me/${coach.whatsapp}`}\r\n        >\r\n          <img src={whatsappIcon} alt=\"Whatsapp\"/>\r\n          Entrar em contato\r\n        </a>\r\n      </footer>\r\n    </article>\r\n  );\r\n}\r\n\r\nexport default CoachItem;","C:\\Users\\paula\\OneDrive\\Documentos\\GitHub\\ifsudestemg-react-native-coach4me\\web\\src\\components\\Select\\index.tsx",[],"C:\\Users\\paula\\OneDrive\\Documentos\\GitHub\\ifsudestemg-react-native-coach4me\\web\\src\\components\\Textarea\\index.tsx",[],"C:\\Users\\paula\\OneDrive\\Documentos\\GitHub\\ifsudestemg-react-native-coach4me\\web\\src\\components\\PageHeader\\index.tsx",[],{"ruleId":"52","severity":1,"message":"53","line":47,"column":9,"nodeType":"54","messageId":"55","endLine":51,"endColumn":10,"fix":"56"},"react/jsx-no-target-blank","Using target=\"_blank\" without rel=\"noreferrer\" (which implies rel=\"noopener\") is a security risk in older browsers: see https://mathiasbynens.github.io/rel-noopener/#recommendations","JSXOpeningElement","noTargetBlankWithoutNoreferrer",{"range":"57","text":"58"},[1062,1062]," rel=\"noreferrer\""]